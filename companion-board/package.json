{
  "name": "kirchhoff-companion-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --jsx react-jsx --module esnext --moduleResolution bundler --target ES2022 --lib ES2022,DOM --skipLibCheck --esModuleInterop main.tsx",
    "build": "npm run typecheck && vite build --config vite.config.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.0.9"
    },
    "@mermaid-js/parser": "1.2.0",
    "dompurify": "3.4.11",
    "lodash-es": "4.18.1",
    "nanoid": "3.3.12",
    "undici": "7.28.0"
  }
}
